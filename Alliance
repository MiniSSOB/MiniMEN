<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiniMEN - Alliances</title>
    <style>
        /* Base Game Styling */
        body { 
            background-color: #000; 
            color: #ddd; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            margin: 0; 
            min-height: 100vh;
        }

        /* Navigation Sidebar */
        #sidebar { 
            width: 220px; 
            background-color: #0a0a0a; 
            padding: 20px 0; 
            border-right: 2px solid #333;
            flex-shrink: 0;
        }
        #sidebar h2 { text-align: center; color: #fff; margin-bottom: 20px; }
        #sidebar a { 
            display: block; 
            color: #85c1e9; 
            text-decoration: none; 
            padding: 10px 20px; 
            border-bottom: 1px solid #222;
            font-weight: bold;
        }
        #sidebar a:hover, #sidebar a.active { 
            background-color: #222; 
            color: #fff; 
            border-left: 4px solid #85c1e9;
        }

        /* Main Content Dashboard */
        #main-content { 
            flex-grow: 1; 
            padding: 30px; 
            background-color: #111;
            overflow-x: auto;
        }
        h1 { color: #fff; border-bottom: 1px solid #333; padding-bottom: 10px; margin-top: 0; }
        
        /* Grid Layout for Top Panels */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .panel {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 4px;
            padding: 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .panel h3 {
            color: #85c1e9;
            margin-top: 0;
            border-bottom: 1px dashed #333;
            padding-bottom: 10px;
            text-transform: uppercase;
            font-size: 1em;
        }
        
        /* Forms and Inputs */
        input[type="text"], select {
            background-color: #000;
            color: #fff;
            border: 1px solid #333;
            padding: 8px;
            font-family: inherit;
            border-radius: 2px;
            width: 80%;
            margin-bottom: 10px;
        }
        button, .btn {
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            padding: 8px 15px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            border-radius: 2px;
            text-decoration: none;
            display: inline-block;
        }
        button:hover, .btn:hover { background-color: #4CAF50; border-color: #4CAF50; }
        
        .text-gold { color: #ffd700; font-weight: bold; }
        .text-muted { color: #888; }

        /* Tables */
        .table-container {
            background-color: #0a0a0a;
            border: 1px solid #333;
            border-radius: 4px;
            margin-bottom: 20px;
            overflow-x: auto;
        }
        table.alliance-table {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
        }
        table.alliance-table th {
            background-color: #1a1a1a;
            color: #85c1e9;
            padding: 12px;
            border-bottom: 2px solid #333;
            text-transform: uppercase;
            font-size: 0.9em;
            white-space: nowrap;
        }
        table.alliance-table td {
            padding: 12px 10px;
            border-bottom: 1px dashed #222;
            vertical-align: middle;
        }
        table.alliance-table tr:hover { background-color: #1a1a1a; }
        table.alliance-table td:nth-child(2) { text-align: left; font-weight: bold; }
        table.alliance-table a { color: #fff; text-decoration: none; }
        table.alliance-table a:hover { color: #85c1e9; text-decoration: underline; }

        /* Pagination & Bottom Controls */
        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background-color: #1a1a1a;
            border-top: 2px solid #333;
        }
        .controls a { color: #ffd700; text-decoration: none; font-weight: bold; }
        .controls a:hover { text-decoration: underline; }
        
        .checker-panel {
            background-color: #1a1a1a;
            border: 1px solid #333;
            padding: 20px;
            border-radius: 4px;
            text-align: center;
            margin-top: 20px;
        }
    </style>
</head>
<body>

    <div id="sidebar">
        <h2>MiniMEN</h2>
        <a href="index.html">Command Center</a>
        <a href="battlefield.html">Battlefield</a>
        <a href="armory.html">Armory</a>
        <a href="conquest.html">Conquest</a>
        <a href="training.html">Training</a>
        <a href="upgrades.html">Upgrades</a>
        <a href="intelligence.html">Intelligence</a>
        <a href="alliances.html" class="active">Alliances</a>
        <a href="trade.html">Trade</a>
        <a href="attack-log.html">Attack Log</a>
        <a href="rewards.html">Rewards</a>
        <a href="statistics.html">Statistics</a>
        <a href="donate.html">Donate</a>
        <a href="buddy-list.html">Buddy List</a>
        <a href="logout.html">Log Out</a>
    </div>

    <div id="main-content">
        <h1>Alliances</h1>
        
        <div class="dashboard-grid">
            <div class="panel">
                <h3>Your Alliance</h3>
                <div style="margin-bottom: 15px; font-weight: bold;">
                    None
                </div>
                <button class="btn" disabled style="opacity: 0.5;">Leave Alliance</button>
            </div>

            <div class="panel">
                <h3>Pending Applications</h3>
                <div class="text-muted" style="margin: auto 0;">
                    None Pending!
                </div>
            </div>

            <div class="panel">
                <h3>Cannot Join</h3>
                <div class="text-muted" style="margin: auto 0;">
                    You haven't annoyed anyone!
                </div>
            </div>

            <div class="panel">
                <h3>Start An Alliance</h3>
                <form action="#" method="POST" style="margin: auto 0;">
                    <input type="text" name="alliance_name" placeholder="Alliance Name..." maxlength="25">
                    <button type="submit" class="btn">Start</button>
                </form>
            </div>
        </div>

        <h2>Alliance List</h2>
        <div class="table-container">
            <table class="alliance-table">
                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Name</th>
                        <th>Members</th>
                        <th>Power</th>
                        <th>Strike</th>
                        <th>Defense</th>
                        <th>Spy</th>
                        <th>Sentry</th>
                    </tr>
                </thead>
                <tbody id="alliance-list-body">
                    <tr>
                        <td colspan="8" style="padding: 30px; color: #888; font-style: italic;">
                            No alliances currently formed. Be the first to start one!
                        </td>
                    </tr>
                </tbody>
            </table>
            
            <div class="controls">
                <a href="#">&lt;&lt; Back</a>
                <span>0 Alliances Total | Page 1 of 1</span>
                <a href="#">Next &gt;&gt;</a>
            </div>
        </div>

        <div class="checker-panel">
            <h3 style="margin-top: 0; color: #fff;">Check Alliance Upgrade</h3>
            <form action="#" method="POST">
                <select name="alliance_upgrade_check" style="width: auto; min-width: 250px;">
                    <option value="None">None</option>
                    <option value="Covert">Covert</option>
                    <option value="Econ">Econ</option>
                    <option value="Experience">Experience</option>
                    <option value="Fort">Fort</option>
                    <option value="Races">Races</option>
                    <option value="Safe">Safe</option>
                    <option value="Sentry">Sentry</option>
                    <option value="Siege">Siege</option>
                    <option value="SPM">SPM</option>
                    <option value="Tech">Tech</option>
                    <option value="TFF">TFF</option>
                </select>
                <button type="submit" class="btn">Check</button>
            </form>
        </div>

    </div>

</body>
</html>
