    <title>MiniMEN - Intelligence</title>
    <style>
        /* Base Game Styling */
        body { 
            background-color: #000; 
            color: #ddd; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            margin: 0; 
            min-height: 100vh;
        }

        /* Navigation Sidebar */
        #sidebar { 
            width: 220px; 
            background-color: #0a0a0a; 
            padding: 20px 0; 
            border-right: 2px solid #333;
            flex-shrink: 0;
        }
        #sidebar h2 { text-align: center; color: #fff; margin-bottom: 20px; }
        #sidebar a { 
            display: block; 
            color: #85c1e9; 
            text-decoration: none; 
            padding: 10px 20px; 
            border-bottom: 1px solid #222;
            font-weight: bold;
        }
        #sidebar a:hover, #sidebar a.active { 
            background-color: #222; 
            color: #fff; 
            border-left: 4px solid #85c1e9;
        }

        /* Main Content Dashboard */
        #main-content { 
            flex-grow: 1; 
            padding: 30px; 
            background-color: #111;
            overflow-x: auto;
        }
        h1 { color: #fff; border-bottom: 1px solid #333; padding-bottom: 10px; margin-top: 0; }
        
        /* Status Bars & Buttons */
        .status-bar {
            background-color: #1a1a1a;
            border: 1px solid #333;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.1em;
            color: #fff;
            display: flex;
            justify-content: space-around;
        }
        .text-gold { color: #ffd700; font-weight: bold; }
        .text-pink { color: #FF1493; }
        .text-red { color: #ff3333; font-weight: bold; }

        .btn {
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            padding: 10px 20px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            font-size: 1.1em;
            border-radius: 2px;
            text-decoration: none;
            display: inline-block;
        }
        .btn:hover { background-color: #4CAF50; border-color: #4CAF50; }

        /* Tables */
        .table-container {
            background-color: #0a0a0a;
            border: 1px solid #333;
            border-radius: 4px;
            margin-bottom: 40px;
            overflow-x: auto;
        }
        table.intel-table {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
        }
        table.intel-table th {
            background-color: #1a1a1a;
            color: #85c1e9;
            padding: 12px;
            border-bottom: 2px solid #333;
            text-transform: uppercase;
            font-size: 0.9em;
        }
        table.intel-table td {
            padding: 10px 12px;
            border-bottom: 1px dashed #222;
            vertical-align: middle;
        }
        table.intel-table tr:hover { background-color: #1a1a1a; }
        table.intel-table a { color: #fff; text-decoration: none; font-weight: bold; }
        table.intel-table a:hover { text-decoration: underline; color: #85c1e9; }

        /* Pagination Controls */
        .controls {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px;
            background-color: #1a1a1a;
            border-top: 2px solid #333;
        }
        .controls a { color: #ffd700; text-decoration: none; font-weight: bold; }
        .controls a:hover { text-decoration: underline; }
    </style>
</head>
