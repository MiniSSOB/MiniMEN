<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiniMEN - Trade Center</title>
    <style>
        /* Base Game Styling */
        body { 
            background-color: #000; 
            color: #ddd; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            margin: 0; 
            min-height: 100vh;
        }

        /* Navigation Sidebar */
        #sidebar { 
            width: 220px; 
            background-color: #0a0a0a; 
            padding: 20px 0; 
            border-right: 2px solid #333;
            flex-shrink: 0;
        }
        #sidebar h2 { text-align: center; color: #fff; margin-bottom: 20px; }
        #sidebar a { 
            display: block; 
            color: #85c1e9; 
            text-decoration: none; 
            padding: 10px 20px; 
            border-bottom: 1px solid #222;
            font-weight: bold;
        }
        #sidebar a:hover, #sidebar a.active { 
            background-color: #222; 
            color: #fff; 
            border-left: 4px solid #85c1e9;
        }

        /* Main Content Dashboard */
        #main-content { 
            flex-grow: 1; 
            padding: 30px; 
            background-color: #111;
            overflow-x: auto;
        }
        h1 { color: #fff; border-bottom: 1px solid #333; padding-bottom: 10px; margin-top: 0; }
        
        /* Status Bars & Alerts */
        .status-bar {
            background-color: #1a1a1a;
            border: 1px solid #333;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.2em;
            color: #fff;
            display: flex;
            justify-content: space-around;
        }
        .text-gold { color: #ffd700; font-weight: bold; }
        .text-blue { color: #85c1e9; font-weight: bold; }
        
        .alert-box {
            background-color: #2a2a00;
            border-left: 4px solid #ffd700;
            padding: 15px;
            margin-bottom: 30px;
            color: #ffd700;
            font-weight: bold;
            border-radius: 2px;
            text-align: center;
        }

        /* Trade Grid Layout */
        .trade-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .trade-card {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 4px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            text-align: center;
        }
        .trade-card h3 {
            margin: 0 0 15px 0;
            color: #85c1e9;
            border-bottom: 1px dashed #333;
            padding-bottom: 10px;
            text-transform: uppercase;
        }
        .trade-info {
            margin-bottom: 20px;
            font-size: 1.1em;
        }
        .trade-subtext {
            color: #888;
            font-size: 0.85em;
            margin-top: 5px;
        }

        /* Inputs & Buttons */
        input[type="text"] {
            background-color: #000;
            color: #fff;
            border: 1px solid #333;
            padding: 10px;
            font-family: inherit;
            font-size: 1.1em;
            border-radius: 2px;
            width: 250px;
            text-align: center;
            margin-right: 10px;
        }
        button, .btn {
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            padding: 12px 20px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            font-size: 1.1em;
            border-radius: 2px;
            width: 100%;
            transition: background-color 0.2s;
        }
        button:hover, .btn:hover { background-color: #4CAF50; border-color: #4CAF50; }
        
        .username-panel {
            background-color: #1a1a1a;
            border: 1px solid #333;
            padding: 30px;
            border-radius: 4px;
            text-align: center;
        }
    </style>
</head>
<body>

    <div id="sidebar">
        <h2>MiniMEN</h2>
        <a href="index.html">Command Center</a>
        <a href="battlefield.html">Battlefield</a>
        <a href="armory.html">Armory</a>
        <a href="conquest.html">Conquest</a>
        <a href="training.html">Training</a>
        <a href="upgrades.html">Upgrades</a>
        <a href="intelligence.html">Intelligence</a>
        <a href="alliances.html">Alliances</a>
        <a href="trade.html" class="active">Trade</a>
        <a href="attack-log.html">Attack Log</a>
        <a href="rewards.html">Rewards</a>
        <a href="statistics.html">Statistics</a>
        <a href="donate.html">Donate</a>
        <a href="buddy-list.html">Buddy List</a>
        <a href="logout.html">Log Out</a>
    </div>

    <div id="main-content">
        <h1>Trade Center</h1>
        
        <div class="status-bar">
            <div>Your Experience: <span class="text-gold">27,832</span></div>
            <div>Your Turns: <span class="text-gold">358</span></div>
        </div>

        <div class="alert-box">
            **** YOU CANNOT USE BANKED EXPERIENCE ON THIS PAGE ****
        </div>

        <h2>Military Assets</h2>
        <div class="trade-grid">
            
            <div class="trade-card">
                <h3>+500 Attack Turns</h3>
                <div class="trade-info">
                    Trade experience for immediate combat turns.
                </div>
                <form action="#" method="POST">
                    <button type="submit" class="btn">Pay 1,425 EXP</button>
                </form>
            </div>

            <div class="trade-card">
                <h3>+1000 Attack Turns</h3>
                <div class="trade-info">
                    Trade experience for a massive boost in combat turns.
                </div>
                <form action="#" method="POST">
                    <button type="submit" class="btn">Pay 2,850 EXP</button>
                </form>
            </div>

            <div class="trade-card">
                <h3>+650 Instant Soldiers</h3>
                <div class="trade-info">
                    Recruit raw soldiers directly into your untrained ranks.
                </div>
                <form action="#" method="POST">
                    <button type="submit" class="btn">Pay 100 EXP</button>
                </form>
            </div>

        </div>

        <h2>Account Utilities</h2>
        <p style="color: #ff3333; font-weight: bold; margin-top: 0;">** Maximum of 2 Commander / 3 Race changes stored at any time. Changes per era are unlimited.</p>
        
        <div class="trade-grid">
            
            <div class="trade-card">
                <h3>Commander Change Credit</h3>
                <div class="trade-info">
                    Stored Credits: <span class="text-gold">1 of 2</span>
                </div>
                <form action="#" method="POST">
                    <button type="submit" class="btn">Pay 3,000 EXP</button>
                </form>
            </div>

            <div class="trade-card">
                <h3>Race Change Credit</h3>
                <div class="trade-info">
                    Stored Credits: <span class="text-gold">2 of 3</span>
                </div>
                <form action="#" method="POST">
                    <button type="submit" class="btn">Pay 10,000 EXP</button>
                </form>
            </div>

        </div>

        <div class="username-panel">
            <h2 style="margin-top: 0; color: #85c1e9;">Free Username Change</h2>
            <p style="color: #ff3333; font-weight: bold; margin-bottom: 20px;">** You can only change your username once per era.</p>
            
            <form action="#" method="POST" style="display: flex; justify-content: center; align-items: center;">
                <input type="text" name="newusername" placeholder="Enter New Username...">
                <button type="submit" class="btn" style="width: auto; padding: 10px 30px;">Change My Username</button>
            </form>
        </div>

    </div>

</body>
</html>
