        <a href="alliances.html">Alliances</a>
        <a href="trade.html">Trade</a>
        <a href="safe.html" class="active">Safe</a>
        <a href="attack-log.html">Attack Log</a>
        <a href="rewards.html">Rewards</a>
        <a href="statistics.html">Statistics</a>
        <a href="donate.html">Donate</a>
        <a href="buddy-list.html">Buddy List</a>
        <a href="logout.html">Log Out</a>
    </div>

    <div id="main-content">
        <h1>The Safe & Financial Operations</h1>
        
        <div class="status-bar">
            <div>Gold: <span class="text-gold">45,104,903</span></div>
            <div>Safe: <span class="text-gold">48,006,339</span></div>
            <div>Vault: <span class="text-gold">0</span></div>
            <div>Experience: <span class="text-gold">27,844</span></div>
            <div>EXP Bank: <span class="text-green">950</span></div>
        </div>

        <div class="dashboard-grid">
            
            <div class="panel">
                <h3>Safe Withdrawal</h3>
                <p style="font-size: 1.2em;">Gold in Safe: <span class="text-gold">48,006,339</span></p>
                <form action="#" method="POST" style="margin-bottom: 20px;">
                    <button type="submit" class="btn" style="width: 80%; padding: 15px; background-color: #660000; border-color: #ff3333;">WITHDRAW ALL</button>
                </form>
                <p style="color: #aaa; font-size: 0.9em;">By clicking "withdraw" you will be withdrawing the whole balance. SAFE gold goes directly into your Vault.</p>
                
                <table class="safe-table">
                    <tr><th colspan="2">SAFE Gold Deposited (5%)**</th></tr>
                    <tr><td>Every Minute</td><td class="text-gold">130,434 Gold</td></tr>
                    <tr><td>Every Hour</td><td class="text-gold">7,826,040 Gold</td></tr>
                    <tr><td>Every Day</td><td class="text-gold">187,824,960 Gold</td></tr>
                </table>
            </div>

            <div class="panel">
                <h3>Experience Deposit</h3>
                <p style="font-size: 1.2em;">Current EXP: <span class="text-gold">27,844</span></p>
                <p style="font-size: 1.2em;">EXP Deposited: <span class="text-green">950</span></p>
                
                <form action="#" method="POST" style="margin-top: 20px; display: flex; justify-content: center; align-items: center;">
                    <input type="number" name="depositamount" placeholder="Amount...">
                    <button type="submit" class="btn" style="background-color: #004d00; border-color: #4CAF50;">DEPOSIT</button>
                </form>
                <p style="color: #aaa; font-size: 0.9em; margin-top: 30px;">Input the amount of Experience you want to secure in the bank.</p>
            </div>

        </div>

        <h2>Civilian & Economic Upgrades</h2>
        <div class="upgrade-grid">
            
            <div class="upgrade-card">
                <h3>Increase Soldiers (SPM)</h3>
                <div class="upgrade-info">
                    <div class="current-level">Wee Laddies Of The Ish<br>3 Soldiers Per Min</div>
                    <div class="next-level">Upgrade to 4 SPM</div>
                </div>
                <button class="btn">412 Experience</button>
            </div>

            <div class="upgrade-card">
                <h3>Economic Development</h3>
                <div class="upgrade-info">
                    <div class="current-level">PortTrade<br>2,525,000 gold/turn</div>
                    <div class="next-level">Research Plantation<br>3,814,600 gold/turn</div>
                </div>
                <button class="btn">42,330 Experience</button>
            </div>

            <div class="upgrade-card">
                <h3>Technological Development</h3>
                <div class="upgrade-info">
                    <div class="current-level">Wheel<br>x1.41 strength</div>
                    <div class="next-level">Research Writing</div>
                </div>
                <button class="btn">800 Experience</button>
            </div>

            <div class="upgrade-card">
                <h3>Safe Size Upgrade</h3>
                <div class="upgrade-info">
                    <div class="current-level">Old Mattress<br>5% Deposit</div>
                    <div class="next-level">Dirty Sock<br>10% Deposit</div>
                </div>
                <button class="btn">5,000 Experience</button>
            </div>

        </div>

        <h2>Current Military Effectiveness</h2>
        <div class="table-container" style="max-width: 600px; margin: 0 auto;">
            <table class="safe-table">
                <thead>
                    <tr>
                        <th>Action</th>
                        <th>Rating</th>
                        <th>Rank</th>
                        <th>Next Rank Rating</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><strong>Strike</strong></td>
                        <td class="text-gold">110,053,181</td>
                        <td>#331</td>
                        <td class="text-blue">111,602,023</td>
                    </tr>
                    <tr>
                        <td><strong>Defense</strong></td>
                        <td class="text-gold">54,348</td>
                        <td>#465</td>
                        <td class="text-blue">55,382</td>
                    </tr>
                    <tr>
                        <td><strong>Spy</strong></td>
                        <td class="text-gold">6,477,811</td>
                        <td>#303</td>
                        <td class="text-blue">6,487,214</td>
                    </tr>
                    <tr>
                        <td><strong>Sentry</strong></td>
                        <td class="text-gold">0</td>
                        <td>#437</td>
                        <td class="text-blue">0</td>
                    </tr>
                </tbody>
            </table>
        </div>

    </div>

</body>
</html>
