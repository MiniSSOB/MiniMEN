<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MiniMEN - Safe</title>
    <style>
        /* Base Game Styling */
        body { 
            background-color: #000; 
            color: #ddd; 
            font-family: 'Courier New', Courier, monospace; 
            display: flex; 
            margin: 0; 
            min-height: 100vh;
        }

        /* Navigation Sidebar */
        #sidebar { 
            width: 220px; 
            background-color: #0a0a0a; 
            padding: 20px 0; 
            border-right: 2px solid #333;
            flex-shrink: 0;
        }
        #sidebar h2 { text-align: center; color: #fff; margin-bottom: 20px; }
        #sidebar a { 
            display: block; 
            color: #85c1e9; 
            text-decoration: none; 
            padding: 10px 20px; 
            border-bottom: 1px solid #222;
            font-weight: bold;
        }
        #sidebar a:hover, #sidebar a.active { 
            background-color: #222; 
            color: #fff; 
            border-left: 4px solid #85c1e9;
        }

        /* Main Content Dashboard */
        #main-content { 
            flex-grow: 1; 
            padding: 30px; 
            background-color: #111;
            overflow-x: auto;
        }
        h1 { color: #fff; border-bottom: 1px solid #333; padding-bottom: 10px; margin-top: 0; }
        
        /* Status Bars & Alerts */
        .status-bar {
            background-color: #1a1a1a;
            border: 1px solid #333;
            padding: 15px;
            border-radius: 4px;
            margin-bottom: 20px;
            text-align: center;
            font-size: 1.1em;
            color: #fff;
            display: flex;
            justify-content: space-around;
        }
        .text-gold { color: #ffd700; font-weight: bold; }
        .text-blue { color: #85c1e9; font-weight: bold; }
        .text-green { color: #4CAF50; font-weight: bold; }

        /* Grid Layouts */
        .dashboard-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }
        .panel {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 4px;
            padding: 20px;
            text-align: center;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .panel h3 {
            color: #85c1e9;
            margin-top: 0;
            border-bottom: 1px dashed #333;
            padding-bottom: 10px;
            text-transform: uppercase;
        }

        /* Forms and Inputs */
        input[type="number"] {
            background-color: #000;
            color: #fff;
            border: 1px solid #333;
            padding: 10px;
            font-family: inherit;
            font-size: 1.1em;
            border-radius: 2px;
            width: 150px;
            text-align: center;
            margin-right: 10px;
        }
        button, .btn {
            background-color: #333;
            color: #fff;
            border: 1px solid #555;
            padding: 10px 20px;
            cursor: pointer;
            font-family: inherit;
            font-weight: bold;
            font-size: 1.1em;
            border-radius: 2px;
            transition: background-color 0.2s;
        }
        button:hover, .btn:hover { background-color: #4CAF50; border-color: #4CAF50; }

        /* Tables */
        table.safe-table {
            width: 100%;
            border-collapse: collapse;
            text-align: center;
            margin-top: 15px;
            font-size: 0.95em;
        }
        table.safe-table th {
            background-color: #222;
            color: #85c1e9;
            padding: 10px;
            border-bottom: 2px solid #333;
        }
        table.safe-table td {
            padding: 8px 10px;
            border-bottom: 1px dashed #222;
        }
        table.safe-table td:first-child { text-align: left; }

        /* Upgrade Cards (Matches Upgrades Page) */
        .upgrade-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 40px;
        }
        .upgrade-card {
            background-color: #1a1a1a;
            border: 1px solid #333;
            border-radius: 4px;
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .upgrade-card h3 { margin: 0 0 15px 0; color: #85c1e9; border-bottom: 1px dashed #333; padding-bottom: 10px; text-align: center; }
        .upgrade-info { display: flex; justify-content: space-between; margin-bottom: 15px; align-items: center; }
        .current-level { color: #aaa; }
        .next-level { color: #fff; font-weight: bold; text-align: right; }
    </style>
</head>
<body>

    <div id="sidebar">
        <h2>MiniMEN</h2>
